# Existing .env is preserved. Copy missing settings manually.
AI_MODE=mock
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=prototype
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.test

# Media ingestion (ffprobe demuxer families, not filename extensions)
MEDIA_MAX_FILE_SIZE_BYTES=5368709120
MEDIA_ALLOWED_FORMATS=["wav","mp3","flac","ogg","mov","matroska"]
MEDIA_UPLOAD_DIR=./data/media
MEDIA_FFPROBE_TIMEOUT_SECONDS=15
MEDIA_FFPROBE_EXECUTABLE=ffprobe

# Capacity per API process: requests above these limits receive HTTP 429.
MEDIA_MAX_CONCURRENT_UPLOADS=2
AUDIO_MAX_CONCURRENT_PROCESSES=1
# Canonical audio; supported pairs: WAV + PCM codec, or FLAC + flac.
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_TARGET_CHANNELS=1
AUDIO_TARGET_CODEC=pcm_s16le
AUDIO_TARGET_FORMAT=wav
AUDIO_FFMPEG_TIMEOUT_SECONDS=900
AUDIO_FFMPEG_EXECUTABLE=ffmpeg

API_KEY=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
NVIDIA_API_KEY=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
SPEECH_ENABLED=true
ASR_PROVIDER=nvidia
DIARIZATION_PROVIDER=nvidia
TRANSCRIPT_CANONICALIZATION_ENABLED=true
MEETING_INTELLIGENCE_ENABLED=true
TRANSCRIPT_CANONICALIZATION_MODEL=gpt-4.1-mini
MEETING_EXTRACTION_MODEL=gpt-4.1-mini
MEETING_RESOLVER_MODEL=gpt-4.1-mini
MEETING_SUMMARY_MODEL=gpt-4.1-mini
