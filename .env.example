# Existing .env is preserved. Copy missing settings manually.
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=prototype
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.test

# Media ingestion (ffprobe demuxer families, not filename extensions)
MEDIA_MAX_FILE_SIZE_BYTES=5368709120
MEDIA_ALLOWED_FORMATS=["wav","mp3","flac","ogg","mov","matroska"]
MEDIA_UPLOAD_DIR=./data/media
MEDIA_FFPROBE_TIMEOUT_SECONDS=15
MEDIA_FFPROBE_EXECUTABLE=ffprobe
