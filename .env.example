# Existing .env is preserved. Copy missing settings manually.
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=prototype
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.test

# Media ingestion (ffprobe demuxer families, not filename extensions)
MEDIA_MAX_FILE_SIZE_BYTES=5368709120
MEDIA_ALLOWED_FORMATS=["wav","mp3","flac","ogg","mov","matroska"]
MEDIA_UPLOAD_DIR=./data/media
MEDIA_FFPROBE_TIMEOUT_SECONDS=15
MEDIA_FFPROBE_EXECUTABLE=ffprobe

# Capacity per API process: requests above these limits receive HTTP 429.
MEDIA_MAX_CONCURRENT_UPLOADS=2
AUDIO_MAX_CONCURRENT_PROCESSES=1
# Canonical audio; supported pairs: WAV + PCM codec, or FLAC + flac.
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_TARGET_CHANNELS=1
AUDIO_TARGET_CODEC=pcm_s16le
AUDIO_TARGET_FORMAT=wav
AUDIO_FFMPEG_TIMEOUT_SECONDS=900
AUDIO_FFMPEG_EXECUTABLE=ffmpeg

# Speech is opt-in; choose cloud nvidia/nvidia or provision local models.
SPEECH_ENABLED=false
ASR_PROVIDER=nemo
DIARIZATION_PROVIDER=nemo
# Required for ASR_PROVIDER=nvidia and DIARIZATION_PROVIDER=nvidia.
NVIDIA_API_KEY=
NVIDIA_ASR_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca
NVIDIA_LANGUAGE_CODE=ru-RU
NVIDIA_MAX_AUDIO_BYTES=16777216
NVIDIA_REQUEST_TIMEOUT_SECONDS=180
NEMO_ASR_MODEL=
# Local streaming Sortformer .nemo checkpoint; fixed speaker capacity depends on model.
NEMO_DIARIZATION_MODEL=
NEMO_DEVICE=cuda
# Replace large-v3 with an absolute local CTranslate2 model directory when enabling.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=default
# Absolute local community-1 directory; no token required at inference time.
PYANNOTE_MODEL=
PYANNOTE_DEVICE=cuda
SPEECH_MAX_DURATION_SECONDS=14400
SPEECH_DIARIZATION_MAX_DECODED_BYTES=536870912
# Increment when replacing weights in-place or upgrading the ML runtime.
SPEECH_MODEL_REVISION=1

# Canonicalization: optional cloud OpenAI text transform; separate from local Speech.
# Uses the existing OPENAI_API_KEY. Off until a model is explicitly configured.
TRANSCRIPT_CANONICALIZATION_ENABLED=false
TRANSCRIPT_CANONICALIZATION_MODEL=
TRANSCRIPT_CANONICAL_LANGUAGE=ru
CANONICALIZATION_BATCH_MAX_SEGMENTS=50
# Actual UTF-8 JSON input budget, including context and IDs (not a tokenizer limit).
CANONICALIZATION_BATCH_MAX_BYTES=12000
CANONICALIZATION_CONTEXT_SEGMENTS=2
CANONICALIZATION_MAX_CONCURRENCY=3
CANONICALIZATION_REQUEST_TIMEOUT_SECONDS=60
CANONICALIZATION_MAX_ATTEMPTS=3
CANONICALIZATION_RETRY_BASE_SECONDS=0.5
CANONICALIZATION_MAX_OUTPUT_TOKENS=4096
